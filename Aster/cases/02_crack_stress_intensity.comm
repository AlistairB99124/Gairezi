import json
import math

DEBUT(CODE=_F(NIV_PUB_WEB='INTERNET'), LANG='EN')

# Step 2: reservoir pressure on the crack faces and stress intensity factors at the crack front.
# No contact yet, so a negative K1 means the faces would be pressed together and contact is needed.
with open('fort.31') as stream:
    inputs = json.load(stream)
with open('fort.32') as stream:
    crack_spec = json.load(stream)
material = inputs['material']
loads = inputs['loads']
spring_per_area = inputs['foundation_spring_n_per_m3']
spring_areas = inputs['spring_areas_m2']

volumes = ('PLINTH', 'WALL', 'HAUNCH')
skins = ('UPSTREAM', 'DOWNSTREAM', 'CREST')

theta = crack_spec['chainage_m'] / crack_spec['centerline_radius_m']
radial = (math.sin(theta), math.cos(theta), 0.0)
tangent = (math.cos(theta), -math.sin(theta), 0.0)
half_depth = 0.5 * crack_spec['depth_m'] + 0.5 * crack_spec['overshoot_m']
centre_radius = crack_spec['upstream_radius_m'] + crack_spec['overshoot_m'] - half_depth
crack_z = crack_spec['z_m'] + crack_spec['z_offset_m']
centre = (centre_radius * radial[0], centre_radius * radial[1], crack_z)

mesh = LIRE_MAILLAGE(FORMAT='MED', UNITE=20)
mesh = MODI_MAILLAGE(reuse=mesh, MAILLAGE=mesh, ORIE_PEAU=_F(GROUP_MA_PEAU=skins))

model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA=volumes + skins, PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='SPRINGS', PHENOMENE='MECANIQUE', MODELISATION='DIS_T'),
    ),
)

crack = DEFI_FISS_XFEM(
    MAILLAGE=mesh,
    TYPE_DISCONTINUITE='FISSURE',
    DEFI_FISS=_F(
        FORM_FISS='RECTANGLE',
        CENTRE=centre,
        DEMI_GRAND_AXE=half_depth,
        DEMI_PETIT_AXE=0.5 * crack_spec['width_m'],
        VECT_X=radial,
        VECT_Y=tangent,
    ),
    INFO=1,
)

model_x = MODI_MODELE_XFEM(MODELE_IN=model, FISSURE=crack, INFO=1)

concrete = DEFI_MATERIAU(
    ELAS=_F(E=material['youngs_modulus_pa'], NU=material['poissons_ratio'], RHO=material['density_kg_m3'])
)
field_mat = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=_F(GROUP_MA=volumes + skins, MATER=concrete))

springs = AFFE_CARA_ELEM(
    MODELE=model_x,
    DISCRET=[
        _F(
            GROUP_MA='SPR%d' % index,
            CARA='K_T_D_N',
            VALE=tuple(k * area for k in spring_per_area),
        )
        for index, area in enumerate(spring_areas)
    ],
)

gravity_z = loads['gravity_z_m_s2']
gravity = AFFE_CHAR_MECA(
    MODELE=model_x,
    PESANTEUR=_F(GRAVITE=abs(gravity_z), DIRECTION=(0.0, 0.0, math.copysign(1.0, gravity_z)), GROUP_MA=volumes),
)

water_gradient = loads['water_density_kg_m3'] * abs(gravity_z)
reservoir_gradient = water_gradient
tailwater_level = loads['foundation_elevation_m'] + loads['tailwater_head_m']

# Pressures depend on z only, so piecewise-linear functions replace the formulas (CALC_G_XFEM rejects formula loads).
upstream_pressure = DEFI_FONCTION(
    NOM_PARA='Z',
    VALE=(-40.0, reservoir_gradient * (40.0 + loads['overflow_head_m']),
          loads['overflow_head_m'], 0.0, max(10.0, loads['overflow_head_m'] + 1.0), 0.0),
    INTERPOL='LIN',
    PROL_GAUCHE='LINEAIRE',
    PROL_DROITE='CONSTANT',
)
tailwater_pressure = DEFI_FONCTION(
    NOM_PARA='Z',
    VALE=(-40.0, water_gradient * (tailwater_level + 40.0), tailwater_level, 0.0, 10.0, 0.0),
    INTERPOL='LIN',
    PROL_GAUCHE='LINEAIRE',
    PROL_DROITE='CONSTANT',
)
hydrostatic = AFFE_CHAR_MECA_F(
    MODELE=model_x,
    PRES_REP=(
        _F(GROUP_MA='UPSTREAM', PRES=upstream_pressure),
        _F(GROUP_MA='DOWNSTREAM', PRES=tailwater_pressure),
    ),
)
overflow = AFFE_CHAR_MECA(
    MODELE=model_x,
    CHAM_MATER=field_mat,
    PRES_REP=_F(GROUP_MA='CREST', PRES=water_gradient * loads['overflow_head_m']),
)

# Water in the crack: reservoir level including the overflow surcharge, constant over the small crack.
crack_depth_below_surface = max(
    -crack_z + crack_spec.get('water_head_above_crest_m', loads['overflow_head_m']), 0.0
)
crack_pressure = water_gradient * crack_depth_below_surface
crack_water = AFFE_CHAR_MECA(
    MODELE=model_x,
    PRES_REP=_F(FISSURE=crack, PRES=crack_pressure),
)

excitations = (
    _F(CHARGE=gravity),
    _F(CHARGE=hydrostatic),
    _F(CHARGE=overflow),
    _F(CHARGE=crack_water),
)

result = MECA_STATIQUE(
    MODELE=model_x,
    CHAM_MATER=field_mat,
    CARA_ELEM=springs,
    EXCIT=excitations,
    SOLVEUR=_F(METHODE='MUMPS', GESTION_MEMOIRE='AUTO'),
)

# CALC_G_XFEM crashes with function-type face loads in this version, so K comes from the lip displacement jump.
k_table = POST_K1_K2_K3(
    FISSURE=crack,
    RESULTAT=result,
    MATER=concrete,
    ABSC_CURV_MAXI=crack_spec['theta_r_sup_m'],
)
IMPR_TABLE(TABLE=k_table, UNITE=6)

values = k_table.EXTR_TABLE().values()
report = {
    'crack_pressure_pa': crack_pressure,
    'table': {name: list(column) for name, column in values.items()},
}
with open('fort.30', 'w') as stream:
    json.dump(report, stream, indent=2)

# Post-processing mesh with the crack as a displacement jump, to measure the opening.
mesh_visu = POST_MAIL_XFEM(MODELE=model_x, INFO=1)
model_visu = AFFE_MODELE(
    MAILLAGE=mesh_visu,
    AFFE=_F(GROUP_MA=volumes, PHENOMENE='MECANIQUE', MODELISATION='3D'),
)
result_visu = POST_CHAM_XFEM(MODELE_VISU=model_visu, RESULTAT=result)
IMPR_RESU(FORMAT='MED', UNITE=80, RESU=_F(RESULTAT=result_visu, NOM_CHAM='DEPL'))

FIN()
