from code_aster.Commands import *
from code_aster import CA
import json
import sys
import numpy as np

DEBUT(LANG="EN")
with open("fort.91", encoding="utf-8") as stream:
    inputs = json.load(stream)
sys.path.insert(0, inputs["repository_root"])
from Aster.native_discrete import read_mesh, characteristics

parameters = inputs["material"]["parameters"]
elastic = inputs["elastic"]
loads = inputs["loads"]
MESH = read_mesh("fort.20", "fort.92")
MESH = MODI_MAILLAGE(reuse=MESH, MAILLAGE=MESH,
                     ORIE_PEAU_3D=_F(GROUP_MA=("UPSTREAM", "DOWNSTREAM", "CREST")))
MODEL = AFFE_MODELE(
    MAILLAGE=MESH,
    AFFE=(
        _F(GROUP_MA=tuple(inputs["linear_model_groups"]),
           PHENOMENE="MECANIQUE", MODELISATION="3D"),
        _F(GROUP_MA="WALL", PHENOMENE="MECANIQUE", MODELISATION="3D"),
        _F(GROUP_MA=("QS_POINTS", "QS_LINKS"), PHENOMENE="MECANIQUE",
           MODELISATION="DIS_T"),
    ),
)
FOUNDATION = DEFI_MATERIAU(ELAS=_F(E=elastic["concrete"]["youngs_modulus_pa"],
                                  NU=elastic["concrete"]["poissons_ratio"],
                                  RHO=elastic["concrete"]["density_kg_m3"]))
BEDROCK = DEFI_MATERIAU(ELAS=_F(E=elastic["bedrock"]["youngs_modulus_pa"],
                                NU=elastic["bedrock"]["poissons_ratio"],
                                RHO=elastic["bedrock"]["density_kg_m3"]))
WALL_DAMAGE = DEFI_MATERIAU(
    ELAS=_F(E=elastic["concrete"]["youngs_modulus_pa"],
            NU=elastic["concrete"]["poissons_ratio"],
            RHO=elastic["concrete"]["density_kg_m3"]),
    BETON_ECRO_LINE=_F(
        SYT=parameters["NO_TENSION_SYT"],
        SYC=parameters["FC"],
        D_SIGM_EPSI=parameters["D_SIGM_EPSI"],
    ),
)
material_assignments = [_F(GROUP_MA="WALL", MATER=WALL_DAMAGE)]
if inputs["has_foundation"]:
    material_assignments.append(_F(GROUP_MA="FOUNDATION", MATER=FOUNDATION))
if inputs["has_bedrock_volume"]:
    material_assignments.append(_F(GROUP_MA="BEDROCK", MATER=BEDROCK))
FIELD = AFFE_MATERIAU(MAILLAGE=MESH, AFFE=tuple(material_assignments))
springs = characteristics(MESH, MODEL, "fort.92")

excitation = []
UPSTREAM = FORMULE(NOM_PARA="Z", VALE="g * max(s - Z, 0.)", g=loads["water_pressure_gradient_pa_per_m"],
                   s=loads["upstream_water_surface_z_m"])
DOWNSTREAM = FORMULE(NOM_PARA="Z", VALE="g * max(t - Z, 0.)", g=loads["water_pressure_gradient_pa_per_m"],
                     t=loads["tailwater_elevation_m"])
CREST = FORMULE(NOM_PARA="Z", VALE="p", p=loads["overflow_surcharge_pa"])
WATER = AFFE_CHAR_MECA_F(MODELE=MODEL, PRES_REP=(_F(GROUP_MA="UPSTREAM", PRES=UPSTREAM),
                                                   _F(GROUP_MA="DOWNSTREAM", PRES=DOWNSTREAM),
                                                   _F(GROUP_MA="CREST", PRES=CREST)))
WEIGHT = AFFE_CHAR_MECA(MODELE=MODEL, PESANTEUR=_F(GRAVITE=loads["gravity_m_s2"], DIRECTION=(0., 0., -1.)))
TIMES = DEFI_LIST_REEL(VALE=inputs["solver_times"])
ARCHIVE_TIMES = DEFI_LIST_REEL(VALE=inputs["times"])
RAMP = DEFI_FONCTION(NOM_PARA="INST", VALE=(0., 0., 1., 1.))
STEPS = DEFI_LIST_INST(
    DEFI_LIST=_F(LIST_INST=TIMES),
    ECHEC=_F(EVENEMENT="ERREUR", ACTION="DECOUPE", SUBD_METHODE="MANUEL", SUBD_PAS=4, SUBD_NIVEAU=4),
)
excitation.extend((_F(CHARGE=WEIGHT, FONC_MULT=RAMP),
                   _F(CHARGE=WATER, FONC_MULT=RAMP)))
RESU = STAT_NON_LINE(
    MODELE=MODEL, CHAM_MATER=FIELD, CARA_ELEM=springs,
    EXCIT=excitation,
    COMPORTEMENT=(
        *((_F(GROUP_MA=tuple(inputs["elastic_groups"]), RELATION="ELAS"),)
          if inputs["elastic_groups"] else ()),
        _F(GROUP_MA=("QS_POINTS", "QS_LINKS"), RELATION="ELAS"),
        _F(GROUP_MA="WALL", RELATION="ENDO_ISOT_BETON", DEFORMATION="PETIT"),
    ),
    INCREMENT=_F(LIST_INST=STEPS),
    ARCHIVAGE=_F(LIST_INST=ARCHIVE_TIMES),
    NEWTON=_F(MATRICE="TANGENTE", REAC_ITER=1),
    CONVERGENCE=_F(
        SIGM_REFE=parameters["FT"], VARI_REFE=1.,
        EFFORT_REFE=inputs["spring_force_reference_n"],
        RESI_REFE_RELA=1e-4, ITER_GLOB_MAXI=50,
    ),
    RECH_LINEAIRE=_F(METHODE="CORDE", ITER_LINE_MAXI=20),
    SOLVEUR=_F(METHODE="MUMPS", NPREC=-1),
)
group_names = ["WALL"]
if inputs["has_foundation"]:
    group_names.append("FOUNDATION")
if inputs["has_bedrock_volume"]:
    group_names.append("BEDROCK")
group_cells = {name: np.asarray(MESH.getCells(name)) for name in group_names}
history, damage_steps = [], []
damage_ids = None
NODE_GEOMETRY = CREA_CHAMP(TYPE_CHAM="NOEU_GEOM_R", OPERATION="EXTR",
                           MAILLAGE=MESH, NOM_CHAM="GEOMETRIE")
POINT_GEOMETRY = CREA_CHAMP(TYPE_CHAM="ELGA_GEOM_R", OPERATION="DISC",
                            MODELE=MODEL, CHAM_GD=NODE_GEOMETRY)
damage_coordinates = None
for index, instant in zip(RESU.getIndexes(), RESU.getAccessParameters()["INST"]):
    values, support = RESU.getField("VARI_ELGA", index).getValuesWithDescription(["V1"], ["WALL"])
    current_ids = np.asarray(list(zip(support[0], support[2], support[3])), dtype=np.int64)
    if damage_ids is None:
        damage_ids = current_ids
        coordinate_lookup = []
        for component in ("X", "Y", "Z"):
            coordinate, description = POINT_GEOMETRY.getValuesWithDescription([component], ["WALL"])
            mapping = dict(zip(zip(description[0], description[2], description[3]), coordinate))
            if not set(map(tuple, damage_ids)).issubset(mapping):
                raise ValueError("Wall damage Gauss-point coordinates are incomplete")
            coordinate_lookup.append([mapping[tuple(point)] for point in damage_ids])
        damage_coordinates = np.asarray(coordinate_lookup).T
    if not np.array_equal(current_ids, damage_ids):
        raise ValueError("Native damage Gauss-point identities changed during the solve")
    values = np.asarray(values)
    if (not np.isfinite(values).all() or values.min() < -1e-7 or values.max() > 1 + 1e-7):
        raise ValueError("Native cracking produced nonfinite, unbounded or healed damage")
    if history and np.any(values < damage_steps[-1] - 1e-7):
        raise ValueError("Native damage healed between converged states")
    damage_steps.append(values)
    sief = RESU.getField("SIEF_ELGA", index)
    peaks = {}
    for name, cells in group_cells.items():
        columns, description = [], None
        for component in ("SIXX", "SIYY", "SIZZ", "SIXY", "SIXZ", "SIYZ"):
            data, description = sief.getValuesWithDescription([component], [name])
            columns.append(np.asarray(data))
        stress = np.column_stack(columns)
        if not np.isfinite(stress).all():
            raise ValueError(f"Nonfinite native cracking stress in {name}")
        tensor = np.empty((len(stress), 3, 3))
        for column, (i, j) in enumerate(((0, 0), (1, 1), (2, 2), (0, 1), (0, 2), (1, 2))):
            tensor[:, i, j] = tensor[:, j, i] = stress[:, column]
        principal = np.linalg.eigvalsh(tensor)
        peaks[name.lower()] = {"maximum_principal_stress_pa": float(principal[:, -1].max()),
                               "minimum_principal_stress_pa": float(principal[:, 0].min())}
        if name == "WALL":
            point_ids = list(zip(description[0], description[2], description[3]))
            wall_principal = dict(zip(point_ids, principal[:, -1]))
            wall_damage = dict(zip(map(tuple, damage_ids), values))
            peak_point = point_ids[int(np.argmax(principal[:, -1]))]
            peak_damage = float(wall_damage[tuple(peak_point)])
            peaks[name.lower()]["maximum_tension_point_damage"] = peak_damage
            peaks[name.lower()]["points_above_wall_tension_tolerance"] = int(
                np.count_nonzero(principal[:, -1] > inputs["wall_tension_tolerance_pa"]))
            damaged = values >= inputs["damage_threshold"]
            if damaged.any():
                residual = [wall_principal[tuple(point)] for point in damage_ids[damaged]]
                peaks[name.lower()]["maximum_cracked_principal_stress_pa"] = float(max(residual))
                peaks[name.lower()]["damage_points_above_threshold"] = int(damaged.sum())
            else:
                peaks[name.lower()]["maximum_cracked_principal_stress_pa"] = None
                peaks[name.lower()]["damage_points_above_threshold"] = 0
    displacement = np.asarray(
        RESU.getField("DEPL", index).getValuesWithDescription(["DX", "DY", "DZ"])[0]).reshape(-1, 3)
    history.append({
        "time": float(instant), "region_stress": peaks,
        "maximum_principal_stress_pa": peaks["wall"]["maximum_principal_stress_pa"],
        "maximum_cracked_principal_stress_pa":
            peaks["wall"]["maximum_cracked_principal_stress_pa"],
        "maximum_displacement_component_m": float(np.abs(displacement).max()),
        "maximum_displacement_magnitude_m": float(np.linalg.norm(displacement, axis=1).max()),
    })
RESU = CALC_CHAMP(reuse=RESU, RESULTAT=RESU, GROUP_MA=tuple(group_names),
                  CONTRAINTE="SIGM_NOEU")
RESU = CALC_CHAMP(reuse=RESU, RESULTAT=RESU, GROUP_MA="WALL", VARI_INTERNE="VARI_NOEU")
IMPR_RESU(
    FORMAT="MED", UNITE=80,
    RESU=(_F(RESULTAT=RESU, NOM_RESU_MED="CRACK", NOM_CHAM="DEPL", NOM_CMP=("DX", "DY", "DZ")),
          _F(RESULTAT=RESU, NOM_RESU_MED="CRACK", NOM_CHAM="SIGM_NOEU"),
          _F(RESULTAT=RESU, NOM_RESU_MED="CRACK", NOM_CHAM="VARI_NOEU", NOM_CMP="V1")),
)
with open("fort.89", "wb") as stream:
    np.savez_compressed(stream, coordinates_m=damage_coordinates,
                        initial_damage=np.zeros(len(damage_ids), dtype=float),
                        damage=np.asarray(damage_steps), damage_point_ids=damage_ids,
                        times=np.asarray([state["time"] for state in history]))
with open("fort.90", "w", encoding="utf-8") as stream:
    json.dump({"audit": {"initial_damage": 0.0, "damage_scope": "all WALL cells"},
              "history": history}, stream, allow_nan=False)
FIN()
