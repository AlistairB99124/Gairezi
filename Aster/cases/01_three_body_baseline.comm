# 01_three_body_baseline.comm - Code_Aster linear-elastic cross-check of the
# CANONICAL Elmer wall+foundation+bedrock model (Elmer.three_body_solver;
# Gairezi/README.md "Integrated wall/foundation/bedrock solver"), as opposed
# to 00_elastic_baseline which only ever ported the legacy wall-only model.
# GENERATED by Aster/generate_three_body_case.py - do not hand-edit the
# numeric values below; regenerate instead so config.json stays the single
# source of truth.
#
# Documented simplifications vs the real Elmer three-body model (see
# Aster/build_three_body_mesh_arrays.py docstring and Aster_Porting.md
# Amendment 3 for the full rationale/numbers): the wall's internal joints
# and the foundation/bedrock interface (bonded in Elmer too) are welded into
# a bonded continuum here, instead of Elmer's discrete two-sided springs.
# The wall/foundation interface is now modelled with real DIS_T springs
# (WALL_FOUNDATION_SPRINGS group, below), matching Elmer's Mortar BC. The
# bedrock's bottom (axis-aligned, Z-normal) keeps a true RIGI_PARASOL roller
# spring; the 4 slanted rock-box sides are approximated as fully fixed
# instead of Elmer's local-frame normal-only roller springs (those
# boundaries sit >50 m from the dam, in the semi-infinite-domain truncation
# region, not the region being compared).

DEBUT(LANG='EN')

MAIL = LIRE_MAILLAGE(FORMAT='MED', UNITE=20, NOM_MED='THREE_BODY', VERI_MAIL=_F(VERIF='NON'))
# Doc u4.21.01 LIRE_MAILLAGE / FORMAT='MED'. GROUP_MA names CONCRETE,
# BEDROCK (volumes); UPSTREAM, DOWNSTREAM, CREST, ROCK_BOTTOM, ROCK_SIDES
# (faces); ROCK_BOTTOM_POI1 (points). VERI_MAIL disabled for the same reason
# as 00_elastic_baseline (avoids a slow geometric re-check on a mesh this
# size; Aster/validate_mesh.py already independently re-validates it).

MAIL = MODI_MAILLAGE(
    reuse=MAIL,
    MAILLAGE=MAIL,
    ORIE_PEAU_3D=_F(GROUP_MA=('UPSTREAM', 'DOWNSTREAM', 'CREST')),
)
# Doc u4.23.04 MODI_MAILLAGE / ORIE_PEAU_3D: same outward-normal fix-up as
# 00_elastic_baseline, required before PRES_REP's sign convention is valid.

MODELE = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            GROUP_MA=(
                'CONCRETE', 'BEDROCK', 'UPSTREAM', 'DOWNSTREAM', 'CREST',
                'ROCK_BOTTOM', 'ROCK_SIDES',
            ),
            PHENOMENE='MECANIQUE',
            MODELISATION='3D',
        ),
        _F(GROUP_MA='ROCK_BOTTOM_POI1', PHENOMENE='MECANIQUE', MODELISATION='DIS_T'),
        _F(GROUP_MA='WALL_FOUNDATION_SPRINGS', PHENOMENE='MECANIQUE', MODELISATION='DIS_T'),
    ),
)
# Doc u4.41.01 AFFE_MODELE: 3-D continuum mechanics on both volumes plus
# every face group that later receives a load/elemental characteristic
# (PRES_REP on UPSTREAM/DOWNSTREAM/CREST, DDL_IMPO on ROCK_SIDES,
# RIGI_PARASOL on ROCK_BOTTOM) - Code_Aster raises MODELISA6_96 if a
# referenced GROUP_MA is absent from the model. ROCK_BOTTOM_POI1 needs its
# own MODELISATION='DIS_T', matching RIGI_PARASOL's GROUP_MA_POI1
# requirement below (same pattern as 00_elastic_baseline's FOUNDATION_POI1).
# WALL_FOUNDATION_SPRINGS (the SEG2 wall/foundation interface elements) is
# also DIS_T: see the DISCRET/K_T_D_L entries in AFFE_CARA_ELEM below for
# the real per-node-pair stiffness (this replaces the former bonded-weld
# approximation at this one interface; see build_three_body_mesh_arrays.py).

CONCRETE_MAT = DEFI_MATERIAU(
    ELAS=_F(
        E=35000000000,
        NU=0.2,
        RHO=2400,
    ),
)
BEDROCK_MAT = DEFI_MATERIAU(
    ELAS=_F(
        E=50000000000,
        NU=0.25,
        RHO=2700,
    ),
)
# Doc u4.43.01 DEFI_MATERIAU / ELAS: config.json material.concrete (wall +
# foundation, both concrete) and material.bedrock (rock), matching the same
# values Elmer.regions.combined_structure / Elmer.graded_bedrock read.

CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(
        _F(GROUP_MA='CONCRETE', MATER=CONCRETE_MAT),
        _F(GROUP_MA='BEDROCK', MATER=BEDROCK_MAT),
    ),
)
# Doc u4.43.03 AFFE_MATERIAU.

GRAVITE = AFFE_CHAR_MECA(
    MODELE=MODELE,
    PESANTEUR=_F(GRAVITE=9.81, DIRECTION=(0.0, 0.0, -1.0)),
)
# Doc u4.44.01 AFFE_CHAR_MECA / PESANTEUR: applies to the whole model (both
# materials/densities), matching Elmer's "rock self-weight and dam loads
# applied together" (diagnostic.json assumptions).

UPSTREAM_PRES = FORMULE(
    NOM_PARA='Z',
    VALE='9810 * max(3 - Z, 0.0)',
)
DOWNSTREAM_PRES = FORMULE(
    NOM_PARA='Z',
    VALE='9810 * max(-27.4726681642 - Z, 0.0)',
)

PRESSIONS = AFFE_CHAR_MECA_F(
    MODELE=MODELE,
    PRES_REP=(
        _F(GROUP_MA='UPSTREAM', PRES=UPSTREAM_PRES),
        _F(GROUP_MA='DOWNSTREAM', PRES=DOWNSTREAM_PRES),
    ),
)
# Doc u4.44.01 AFFE_CHAR_MECA_F / PRES_REP with a FORMULE argument, identical
# in form to 00_elastic_baseline's hydrostatic loads.

CREST_SURCHARGE = AFFE_CHAR_MECA(
    MODELE=MODELE,
    PRES_REP=_F(GROUP_MA='CREST', PRES=29430),
)

# --- Bedrock outer boundary ----------------------------------------------
# ROCK_BOTTOM (true axis-aligned normal = global -Z): a real RIGI_PARASOL
# normal-only roller spring, matching Elmer's rock_outer_support exactly for
# this face (material.bedrock.support.spring_n_per_m3.z, scaled by the
# ROCK_BOTTOM group's total area -- same global-stiffness convention as
# 00_elastic_baseline's FOUNDATION RIGI_PARASOL; see that script's comments
# for the doc u4.42.01 section 17.4.4 citation). X/Y left at 0 (free) so
# this is a true one-directional roller, not a full 3-axis spring.
CARA_ROCK = AFFE_CARA_ELEM(
