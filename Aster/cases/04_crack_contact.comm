import json
import math

DEBUT(CODE=_F(NIV_PUB_WEB='INTERNET'), LANG='EN')

# Horizontal crack on a mesh layer with split nodes: unilateral contact with Coulomb friction between the lips.
# Water acts on both lips at the reservoir level including the overflow surcharge.
with open('fort.31') as stream:
    inputs = json.load(stream)
with open('fort.32') as stream:
    spec = json.load(stream)
material = inputs['material']
loads = inputs['loads']
spring_per_area = inputs['foundation_spring_n_per_m3']
spring_areas = inputs['spring_areas_m2']

volumes = ('PLINTH', 'WALL', 'HAUNCH')
skins = ('UPSTREAM', 'DOWNSTREAM', 'CREST')
lips = ('CRACK_LOW', 'CRACK_UP')

mesh = LIRE_MAILLAGE(FORMAT='MED', UNITE=20)
mesh = MODI_MAILLAGE(reuse=mesh, MAILLAGE=mesh, ORIE_PEAU=_F(GROUP_MA_PEAU=skins + lips))

# Nodes shared by both lips are the crack front; they stay bonded and are left out of the contact pairing.
mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_NO=(_F(GROUP_MA='CRACK_LOW', NOM='N_LOW'), _F(GROUP_MA='CRACK_UP', NOM='N_UP')),
)
mesh = DEFI_GROUP(reuse=mesh, MAILLAGE=mesh, CREA_GROUP_NO=_F(INTERSEC=('N_LOW', 'N_UP'), NOM='N_FRONT'))

model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA=volumes + skins + lips, PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='SPRINGS', PHENOMENE='MECANIQUE', MODELISATION='DIS_T'),
    ),
)

concrete = DEFI_MATERIAU(
    ELAS=_F(E=material['youngs_modulus_pa'], NU=material['poissons_ratio'], RHO=material['density_kg_m3'])
)
field_mat = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=_F(GROUP_MA=volumes + skins + lips, MATER=concrete))

springs = AFFE_CARA_ELEM(
    MODELE=model,
    DISCRET=[
        _F(
            GROUP_MA='SPR%d' % index,
            CARA='K_T_D_N',
            VALE=tuple(k * area for k in spring_per_area),
        )
        for index, area in enumerate(spring_areas)
    ],
)

gravity_z = loads['gravity_z_m_s2']
gravity = AFFE_CHAR_MECA(
    MODELE=model,
    PESANTEUR=_F(GRAVITE=abs(gravity_z), DIRECTION=(0.0, 0.0, math.copysign(1.0, gravity_z)), GROUP_MA=volumes),
)

water_gradient = loads['water_density_kg_m3'] * abs(gravity_z)
reservoir_gradient = water_gradient
tailwater_level = loads['foundation_elevation_m'] + loads['tailwater_head_m']

upstream_pressure = FORMULE(
    VALE='%.12g*max(%.12g - Z, 0.0)' % (reservoir_gradient, loads['overflow_head_m']), NOM_PARA=('X', 'Y', 'Z')
)
tailwater_pressure = FORMULE(
    VALE='%.12g*max(%.12g - Z, 0.0)' % (water_gradient, tailwater_level), NOM_PARA=('X', 'Y', 'Z')
)
hydrostatic = AFFE_CHAR_MECA_F(
    MODELE=model,
    PRES_REP=(
        _F(GROUP_MA='UPSTREAM', PRES=upstream_pressure),
        _F(GROUP_MA='DOWNSTREAM', PRES=tailwater_pressure),
    ),
)
overflow = AFFE_CHAR_MECA(
    MODELE=model,
    PRES_REP=_F(GROUP_MA='CREST', PRES=water_gradient * loads['overflow_head_m']),
)

crack_pressure = water_gradient * max(
    -spec['z_m'] + spec.get('water_head_above_crest_m', loads['overflow_head_m']), 0.0
)
crack_water = AFFE_CHAR_MECA(
    MODELE=model,
    PRES_REP=_F(GROUP_MA=lips, PRES=crack_pressure),
)

contact = DEFI_CONTACT(
    MODELE=model,
    FORMULATION='CONTINUE',
    FROTTEMENT='COULOMB',
    ZONE=_F(
        GROUP_MA_MAIT='CRACK_LOW',
        GROUP_MA_ESCL='CRACK_UP',
        SANS_GROUP_NO='N_FRONT',
        COULOMB=spec['friction_coefficient'],
        ALGO_CONT='STANDARD',
        ALGO_FROT='STANDARD',
    ),
)

ramp = DEFI_FONCTION(NOM_PARA='INST', VALE=(0.0, 0.0, 1.0, 1.0))
times = DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=1.0, NOMBRE=spec.get('load_steps', 4)))
steps = DEFI_LIST_INST(
    DEFI_LIST=_F(LIST_INST=times),
    ECHEC=_F(ACTION='DECOUPE', SUBD_METHODE='MANUEL', SUBD_NIVEAU=3),
)

if spec.get('fast'):
    newton = _F(MATRICE='ELASTIQUE')
    max_iterations = 120
else:
    newton = _F(REAC_ITER=1)
    max_iterations = 40

result = STAT_NON_LINE(
    MODELE=model,
    CHAM_MATER=field_mat,
    CARA_ELEM=springs,
    EXCIT=(
        _F(CHARGE=gravity, FONC_MULT=ramp),
        _F(CHARGE=hydrostatic, FONC_MULT=ramp),
        _F(CHARGE=overflow, FONC_MULT=ramp),
        _F(CHARGE=crack_water, FONC_MULT=ramp),
    ),
    CONTACT=contact,
    COMPORTEMENT=_F(RELATION='ELAS', TOUT='OUI'),
    INCREMENT=_F(LIST_INST=steps),
    NEWTON=newton,
    CONVERGENCE=_F(RESI_GLOB_RELA=1.0e-6, ITER_GLOB_MAXI=max_iterations),
    SOLVEUR=_F(METHODE='MUMPS', GESTION_MEMOIRE='AUTO'),
)

result = CALC_CHAMP(
    reuse=result,
    RESULTAT=result,
    CONTRAINTE=('SIGM_ELNO', 'SIGM_NOEU'),
)

IMPR_RESU(
    FORMAT='MED',
    UNITE=80,
    RESU=_F(RESULTAT=result, NOM_CHAM=('DEPL', 'SIGM_NOEU'), INST=1.0),
)

FIN()
